{
  "name": "ppp-command-center",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "smoke": "node scripts/smoke-pages.mjs",
    "check:enums": "node scripts/check-db-enums.mjs",
    "check:tour-targets": "node scripts/check-tour-targets.mjs",
    "check:one-off": "node --env-file=.env.local --loader ./scripts/app-module-loader.mjs scripts/check-one-off-flow.mjs",
    "check:guide-pages": "node --loader ./scripts/app-module-loader.mjs scripts/check-guide-pagination.mjs",
    "check:receipt": "node --env-file=.env.local --loader ./scripts/app-module-loader.mjs scripts/check-receipt-path.mjs",
    "check:schema": "node scripts/check-schema-drift.mjs",
    "verify:messaging": "node --experimental-strip-types --import ./scripts/ts-resolve-register.mjs scripts/verify-messaging-e2e.mjs",
    "verify": "node scripts/verify.mjs && npm run verify:inbound && npm run verify:twilio-inbound && npm run verify:workspace && npm run verify:drafts && npm run verify:workflow && npm run verify:campaign-edit && npm run verify:pii",
    "build:aia-template": "node scripts/build-aia-template.mjs",
    "verify:inbound": "node --env-file=.env.local --import ./scripts/ts-resolve-register.mjs scripts/verify-inbound-e2e.mjs",
    "verify:twilio-inbound": "node --env-file=.env.local --import ./scripts/ts-resolve-register.mjs scripts/verify-twilio-inbound-e2e.mjs",
    "check:sf-fields": "node scripts/check-sf-fields.mjs",
    "verify:workspace": "node --env-file=.env.local --import ./scripts/ts-resolve-register.mjs scripts/verify-workspace-config-e2e.mjs",
    "check:sf-picklists": "node --import ./scripts/ts-resolve-register.mjs scripts/check-sf-picklists.mjs",
    "verify:drafts": "node --env-file=.env.local --import ./scripts/ts-resolve-register.mjs scripts/verify-drafts-e2e.mjs",
    "verify:workflow": "node --env-file=.env.local --import ./scripts/ts-resolve-register.mjs scripts/verify-workflow-e2e.mjs",
    "verify:campaign-edit": "node --env-file=.env.local --import ./scripts/ts-resolve-register.mjs scripts/verify-campaign-edit-e2e.mjs",
    "check:columns": "node --env-file=.env.local scripts/check-selected-columns.mjs",
    "import:rules": "node --env-file=.env.local --import ./scripts/ts-resolve-register.mjs scripts/import-class-a-rules.mjs",
    "import:rated": "node --env-file=.env.local --import ./scripts/ts-resolve-register.mjs scripts/import-rated-conversations.mjs",
    "verify:pii": "node --env-file=.env.local --import ./scripts/ts-resolve-register.mjs scripts/verify-no-pii-e2e.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@react-pdf/renderer": "^4.5.1",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.0",
    "exceljs": "^4.4.0",
    "isomorphic-dompurify": "^3.19.0",
    "jsforce": "^3.10.15",
    "mapbox-gl": "^3.24.0",
    "next": "16.2.6",
    "pdf-lib": "^1.17.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-map-gl": "^8.1.1",
    "react-virtuoso": "^4.18.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
